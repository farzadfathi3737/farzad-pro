# ---------------------------------------------------------------------------
# همه‌ی این مقادیر اختیاری‌اند. اگر چیزی ست نشود، خودِ اپ مقدار مناسب می‌سازد
# و در پوشه data/ ذخیره می‌کند. روی هاست‌های PaaS (Render/Railway/Koyeb) که
# دیسک پایدار ندارند، UUID / TROJAN_PASSWORD / SUB_TOKEN / PANEL_PASSWORD را
# به‌عنوان Environment Variable ست کنید تا با هر دیپلوی تغییر نکنند.
# ---------------------------------------------------------------------------

# پورت داخلی که هاست به اپ می‌دهد (Render/Railway خودشان PORT را ست می‌کنند)
# PORT=3000

# دامنه‌ای که کلاینت‌ها به آن وصل می‌شوند و SNI/Host کانفیگ‌هاست.
# روی PaaS خودکار پیدا می‌شود. اگر پشت Cloudflare Worker هستید، دامنه‌ی Worker را بدهید.
# HOST=my-app.onrender.com

# پورتی که کلاینت‌ها به آن وصل می‌شوند (روی PaaS: 443 — روی VPS: همان PORT)
# PUBLIC_PORT=443

# حالت TLS:
#   proxy → هاست/کلودفلر خودش TLS را هندل می‌کند — پیش‌فرض روی PaaS
#   self  → اپ خودش HTTPS با گواهی خودامضا بالا می‌آورد (VPS با پورت خام؛ به openssl نیاز دارد)
#   off   → بدون TLS — پیش‌فرض خارج از PaaS
# TLS_MODE=proxy

# اعتبارنامه‌ها (اگر خالی بمانند تولید و ذخیره می‌شوند)
# UUID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# TROJAN_PASSWORD=
# SUB_TOKEN=
# PANEL_PASSWORD=

# IPهای تمیز اولیه (با کاما جدا کنید) — از داخل پنل هم قابل ویرایش است
# CLEAN_IPS=162.159.192.1,188.114.96.1

# مسیر پنل و سابسکریپشن
# PANEL_PATH=panel
# SUB_PATH=sub

# نام کانفیگ‌ها در کلاینت
# CONFIG_NAME=V2Gate

# فعال/غیرفعال کردن پروتکل‌ها
# ENABLE_VLESS_WS=true
# ENABLE_TROJAN_WS=true
# ENABLE_VLESS_HTTPUPGRADE=true
# ENABLE_TROJAN_HTTPUPGRADE=false
# ENABLE_VLESS_XHTTP=true
# ENABLE_TROJAN_XHTTP=false

# موتور اختیاری Xray (کنار موتور بومی) — VMess و Shadowsocks
# ENABLE_XRAY=true
# ENABLE_VMESS_WS=true
# ENABLE_VMESS_HTTPUPGRADE=true
# ENABLE_SS_WS=true
# SS_METHOD=aes-128-gcm
# SS_PASSWORD=
# XRAY_VERSION=latest
# XRAY_BASE_PORT=10100
# XRAY_LOG_LEVEL=warning

# VLESS + Reality (فقط VPS با IP مستقیم؛ auto = اگر پورت آزاد بود روشن شود)
# ENABLE_REALITY=auto
# REALITY_PORT=0             # پورت عمومی اضافه برای Reality (مثلاً 443 روی VPS)؛ 0 = فقط روی پورت اصلی
# REALITY_DEST=dl.google.com:443
# REALITY_SNI=
# REALITY_ADDRESS=

# کانفیگ‌های مستقیم (IP:پورت، بدون CDN، گواهی خودامضا) — auto = وقتی IP عمومی و گواهی موجود باشد
# ENABLE_DIRECT=auto
# DIRECT_PORT=                # اگر پورت عمومی با PORT فرق دارد (کانتینر/NAT)
# DIRECT_SNI=                 # SNI لینک‌های مستقیم؛ پیش‌فرض HOST
# PUBLIC_IP=                  # اگر تشخیص خودکار IP عمومی درست نبود

# مسیرهای WebSocket (پیش‌فرض از روی UUID ساخته می‌شود)
# PATH_VLESS_WS=/vless-xxxxxxxx
# PATH_TROJAN_WS=/trojan-xxxxxxxx
# PATH_VLESS_HU=/hu-xxxxxxxx
# PATH_TROJAN_HU=/thu-xxxxxxxx

# موتور پروکسی
# DNS_RESOLVER=8.8.8.8        # برای درخواست‌های DNS کلاینت (UDP→TCP)
# IDLE_TIMEOUT=300            # ثانیه؛ بستن اتصال‌های بی‌کار
# BLOCK_PRIVATE=true          # بستن دسترسی به شبکه‌ی داخلی سرور
# VERBOSE=false               # لاگ هر اتصال
# SELFTEST_URL=http://www.gstatic.com/generate_204
